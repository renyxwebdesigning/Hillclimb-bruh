                <div class="hr-bar" role="progressbar" aria-label="Loading" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="hr-fill"></div></div>
                <div class="hr-slow">Still loading. The first visit can take up to a minute on a slow connection.</div>
            </div>
            <button class="hr-play" type="button"><span>TAP TO PLAY</span></button>
            <div class="hr-tip"></div>
            <div class="hr-rotate">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg>
                Turn your phone sideways
            </div>
        </div>
    </div>

    <script>
    (function () {
        var root = document.getElementById("hr-loader");
        var fill = root.querySelector(".hr-fill"), bar = root.querySelector(".hr-bar");
        var statusEl = root.querySelector(".hr-status"), pctEl = root.querySelector(".hr-pct");
        var tipEl = root.querySelector(".hr-tip"), playBtn = root.querySelector(".hr-play");

        // stars
        var sky = root.querySelector(".hr-stars"), html = "";
        for (var i = 0; i < 70; i++) {
            var sz = Math.random() < .15 ? 3 : 2;
            html += '<i style="left:' + (Math.random() * 100).toFixed(2) + '%;top:' + (Math.random() * 100).toFixed(2) +
                    '%;width:' + sz + 'px;height:' + sz + 'px;animation-delay:' + (Math.random() * 3).toFixed(2) + 's"></i>';
        }
        sky.innerHTML = html;

        // tips
        var tips = [
            "Hold <b>SPACE</b> for a rocket boost",
            "Engine seized? Hammer <b>ENTER</b> to fix it",
            "Press <b>H</b> to honk. Puppy or ship horn, your choice",
            "Land <b>flips</b> for bonus coins",
            "Secret trophies hide high in the air",
            "Jump the lava pits on <b>Volcano</b>",
            "On a phone, the pedals are in the bottom corners",
            "Beat your own <b>ghost</b> from your best run"
        ];
        var tipN = Math.floor(Math.random() * tips.length);
        function nextTip() {
            tipEl.style.opacity = 0;
            setTimeout(function () { tipEl.innerHTML = tips[tipN++ % tips.length]; tipEl.style.opacity = 1; }, 400);
        }
        tipEl.innerHTML = tips[tipN++ % tips.length];
        setInterval(nextTip, 4000);

        // progress: each stage creeps from `from` toward `to`; the runtime download uses real numbers
        var STAGES = {
            boot:   [0, 40, "Downloading the game engine"],
            fetch:  [42, 60, "Loading maps and vehicles"],
            unpack: [60, 70, "Unpacking"],
            tap:    [72, 72, "Ready!"],
            start:  [74, 86, "Starting the engine"],
            pkg:    [80, 94, "Installing the physics"],
            done:   [100, 100, "Let's go!"]
        };
        var st = { name: "boot", from: 0, to: 40, t0: performance.now(), shown: 0, finished: false };
        var t0 = performance.now();
        var dl = document.getElementById("progress");

        function stage(name) {
            if (st.finished || !STAGES[name]) return;
            if (name === "tap" && st.name !== "boot" && st.name !== "fetch" && st.name !== "unpack") return;
            var s = STAGES[name];
            st.name = name;
            st.from = Math.max(s[0], st.shown);
            st.to = Math.max(s[1], st.from);
            st.t0 = performance.now();
            statusEl.textContent = s[2];
            root.classList.toggle("hr-ready", name === "tap");
            if (name === "tap") { try { playBtn.focus({ preventScroll: true }); } catch (e) {} }
            if (name === "done") finish();
        }

        function finish() {
            st.finished = true;
            st.shown = 100; render();
            setTimeout(function () {
                root.classList.add("hr-hide");
                var c = document.getElementById("canvas");
                if (c) { try { c.focus(); } catch (e) {} }
                setTimeout(function () { root.remove(); }, 800);
            }, 250);
        }

        function render() {
            fill.style.transform = "scaleX(" + (st.shown / 100).toFixed(4) + ")";
            pctEl.textContent = Math.floor(st.shown) + "%";
            bar.setAttribute("aria-valuenow", Math.floor(st.shown));
        }

        function tick(now) {
            if (st.finished) return;
            var target;
            if (st.name === "boot" && dl && dl.value > 0 && !dl.hidden) {
                target = Math.min(40, Math.max(2, dl.value * .4));
            } else {
                var k = 1 - Math.exp(-(now - st.t0) / 5000);
                target = st.from + (st.to - st.from) * k;
            }
            st.shown += (target - st.shown) * .12;
            render();
            root.classList.toggle("hr-is-slow", now - t0 > 50000 && st.name !== "tap");
            requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);

        // tapping anywhere unlocks sound; the game continues by itself once the browser allows it
        function tapped() { if (st.name === "tap") stage("start"); }
        root.addEventListener("click", tapped);
        playBtn.addEventListener("click", tapped);

        window.hr_stage = stage;
        (window.__hr_q || []).forEach(function (a) { stage.apply(null, a); });
        window.__hr_q = [];
    })();
    </script>

    <script>
    // Fullscreen: the game draws the buttons and tells us where they are (hr_fs_set/add, fractions of the
    // canvas); browsers only allow fullscreen inside the tap itself, so the page handles that tap.
    (function () {
        var rects = [], last = 0, d = document;
        function on() { return !!(d.fullscreenElement || d.webkitFullscreenElement); }
        window.hr_fs_ok = function () {
            return (d.fullscreenEnabled || d.webkitFullscreenEnabled) ? 1 : 0;
        };
        window.hr_fs_on = function () { return on() ? 1 : 0; };
        window.hr_fs_set = function (x, y, w, h) { rects = x < 0 ? [] : [[x, y, w, h]]; };
        window.hr_fs_add = function (x, y, w, h) { rects.push([x, y, w, h]); };
        function toggle() {
            if (on()) {
                (d.exitFullscreen || d.webkitExitFullscreen).call(d);
                return;
            }
            var el = d.documentElement;
            var req = el.requestFullscreen || el.webkitRequestFullscreen;
            if (!req) return;
            var p = req.call(el, { navigationUI: "hide" });
            if (p && p.then) {
                p.then(function () {
                    try { screen.orientation.lock("landscape").catch(function () {}); } catch (e) {}
                }).catch(function () {});
            }
        }
        function up(e) {
            if (!rects.length) return;
            var c = d.getElementById("canvas");
            if (!c) return;
            var b = c.getBoundingClientRect();
            var p = e.changedTouches ? e.changedTouches[0] : e;
            var x = (p.clientX - b.left) / b.width, y = (p.clientY - b.top) / b.height;
            var inside = rects.some(function (r) { return x >= r[0] && x <= r[0] + r[2] && y >= r[1] && y <= r[1] + r[3]; });
            if (!inside) return;
            var now = Date.now();
            if (now - last < 500) return;        // touchend and pointerup both fire for one tap
            last = now;
            toggle();
        }
        d.addEventListener("pointerup", up, true);
        d.addEventListener("touchend", up, true);
        // after the page changes shape, re-fit the canvas
        d.addEventListener("fullscreenchange", function () { if (window.window_resize) window_resize(); });
        d.addEventListener("webkitfullscreenchange", function () { if (window.window_resize) window_resize(); });
    })();
    </script>

